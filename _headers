/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
*/

# HTML：每次协商（内容变了立刻生效）
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ⚠️ CSS/JS 绝不能设 immutable 长缓存：
# 文件名不变时，immutable 会让浏览器与边缘节点在 TTL 内完全不重新验证，
# 出现「HTML 已更新、CSS 还是旧版」→ 页面裸奔，回访用户长期也修不好。
# 这两类文件改用协商缓存（304 极快），保证永远拿到最新。
/assets/style.css
  Cache-Control: public, max-age=0, must-revalidate

# 用通配覆盖全部 JS：原来只列了 app.js，新增的 auth.js / pending.js 会落到默认规则，
# 一旦日后修改这两个文件就会重现「HTML 已更新、JS 还是旧版」的缓存事故
/assets/*.js
  Cache-Control: public, max-age=0, must-revalidate

# 图标与图片内容稳定，长缓存安全（换图时请改文件名）
/assets/favicon.svg
  Cache-Control: public, max-age=604800, immutable

/assets/apple-touch-icon.png
  Cache-Control: public, max-age=604800, immutable

/assets/img/*
  Cache-Control: public, max-age=604800, immutable
